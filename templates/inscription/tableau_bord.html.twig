<table border="1">
    <thead>
        <tr>
            <th>Indicateur</th>
            <th>Valeur</th>
            <th>Unité</th>
        </tr>
    </thead>
    <tbody>
            {% for ligne in data %}
               <tr>
                <td>{{ ligne.libelle }}</td>
                <td>{{ ligne.valeur|number_format(2,'.', ' ') }}</td>
                <td>{{ ligne.unite }}</td>
               </tr>
            {% endfor %} 
    </tbody>
</table>
